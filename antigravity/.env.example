GEMINI_API_KEY=

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=antigravity

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=antigravity_secret_key_change_in_production
SOCKET_SECRET=secreto_interno_antigravity

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

OWNER_EMAIL=dueno@tuemail.com

PORT_BOT=3001
PORT_API=3002
PORT_INSTANCE_MANAGER=3001

FRONTEND_URL=https://antigravity.co
FRONTEND_API_URL=http://localhost:3002
FRONTEND_SOCKET_URL=http://localhost:3002

# URL pública del portal del domiciliario/tracking (antigravity/frontend) que el
# bot manda al cliente por WhatsApp para que siga su pedido. En producción debe
# ser el dominio real de ese frontend (ver infra/nginx.conf).
TRACKING_BASE_URL=http://localhost:5177/delivery/track

NODE_ENV=development

# Voice Bot (bot de llamadas) — ver api/routes/voice.js
CLONAR_VOZ_URL=http://127.0.0.1:8080
STT_PROVIDER=whisper_local
DEEPGRAM_API_KEY=
WHISPER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_PUBLIC_URL=
TWILIO_VALIDATE_SIGNATURE=true

# Pagos de suscripción. Pasarela real: Efipay (api/services/efipay.js). Con
# EFIPAY_ACCESS_TOKEN y EFIPAY_OFFICE_ID definidos, Efipay manda sobre Stripe.
# Sin ninguna pasarela los pagos son de PRUEBA y solo funcionan fuera de
# producción (NODE_ENV != production). Antes de usar Efipay: node db/migrate_efipay.js
EFIPAY_API_URL=https://sag.efipay.co/api/v1
EFIPAY_ACCESS_TOKEN=
EFIPAY_OFFICE_ID=
# Token con el que Efipay firma sus webhooks (HMAC-SHA256 del cuerpo, cabecera "Signature")
EFIPAY_WEBHOOK_TOKEN=
# Opcional: plantilla de checkout personalizada
EFIPAY_CHECKOUT_TEMPLATE_ID=
# URL pública de ESTA api — Efipay la usa para llamar al webhook (/api/webhook/efipay).
# En desarrollo local no es alcanzable: el estado se consulta al volver al sitio.
API_PUBLIC_URL=http://localhost:3002

# Stripe (alternativa, opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo para demos: permite pagos de prueba con NODE_ENV=production. Nunca en un despliegue real.
PAGOS_EMULADOS=false

# TravelTime (mapas y geocodificación de domicilios) — traveltime.com
# El App Id también va en frontend/.env y agency-platform-react/.env.local como
# VITE_TRAVELTIME_APP_ID (es público, solo sirve tiles). La Api Key es secreta
# y SOLO debe vivir acá — nunca en un .env de frontend.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Caja (plan Emprendedor): app aparte de inventario, ventas y plata. Antigravity
# le entrega al cliente un JWT de 12 h (POST /api/caja/token) que la caja valida
# con este secreto. Debe ser DISTINTO de JWT_SECRET y el mismo valor que se
# configura en la caja. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sin estas dos variables, /api/caja/token responde 503 (no hay valor por defecto).
CAJA_JWT_SECRET=
# URL pública de la caja, sin barra final (ej. https://caja.tudominio.co)
CAJA_URL=

# Avisos Web Push de pedido nuevo / pago confirmado (PWA fase 2). Genera el par con:
#   npx web-push generate-vapid-keys
# Sin PUSH_VAPID_PUBLIC_KEY y PUSH_VAPID_PRIVATE_KEY la función queda apagada
# (los avisos no se envían y Ajustes no muestra el botón "Activar avisos"); nada más se rompe.
# PUSH_VAPID_SUBJECT: un mailto: o https: de contacto que exige el estándar.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:soporte@antigravity.co

# Opcionales al arrancar la API (ver api/arranque.js)
# RUN_MIGRATIONS_ON_START=true
# ADMIN_EMAIL=tu@correo.com
